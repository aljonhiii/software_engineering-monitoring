# Server Configuration
PORT=3000
NODE_ENV=development

# MariaDB / MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kixcleen_db

# Security & JWT Secrets
JWT_SECRET=kixcleen_super_secret_jwt_key_2026_monitor
JWT_EXPIRES_IN=7d

# Machine Telemetry & Kiosk App
DEFAULT_KIOSK_ID=KIOSK-01-MAIN
HEARTBEAT_TIMEOUT_SECONDS=60
KIOSK_BASE_URL=http://localhost:8081

# Frontend Portal URL for Invitations (leave empty to auto-detect computer's Wi-Fi LAN IP so mobile devices connect seamlessly)
# FRONTEND_URL=https://app.kixcleen.com

# Email Service & SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="KixCleen Platform" <your_email@gmail.com>
